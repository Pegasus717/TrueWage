# Copy to .env (never commit .env). Everything is optional.

# ONLINE DATABASE (recommended): your Supabase "Session pooler" connection string, e.g.
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ becomes %40). Leave empty to use the local SQLite file.
# Needs: pip install -r requirements.txt     Verify with: python tools/db_check.py
DATABASE_URL=

ANTHROPIC_API_KEY=
TRUEWAGE_MODEL=claude-haiku-5-5
PORT=8080
# Set to 1 only when running behind your own reverse proxy (Caddy/nginx) so rate limits use the real client IP
TRUEWAGE_TRUST_PROXY=0
# Force the Secure flag on the login cookie (use when serving over HTTPS)
TRUEWAGE_COOKIE_SECURE=0
# AI screenshot reading: cheap model first, stronger model only for screens the first pass could not read
TRUEWAGE_EXTRACT_MODEL=claude-haiku-5-5
TRUEWAGE_ESCALATE_MODEL=claude-sonnet-5-5
# Hard ceiling on images sent to the AI per day (above it the app silently uses the on-device reader)
TRUEWAGE_AI_DAILY_IMAGES=400
# Per-rider daily limits (signed-in riders): images read by AI, and Ask questions
TRUEWAGE_AI_USER_DAILY=60
TRUEWAGE_AI_USER_ASKS=100
# Phone numbers (comma separated) of riders allowed to open the Admin overview (list of all riders, counts, AI usage)
TRUEWAGE_ADMIN_PHONES=
