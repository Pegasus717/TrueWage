{
  "name": "TrueWage",
  "short_name": "TrueWage",
  "description": "What a gig worker really earns, after fuel, repairs, data, EMI and waiting.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EFEBE2",
  "theme_color": "#0E1116",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shots",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Check an order",
      "url": "/?go=check"
    },
    {
      "name": "Add screenshots",
      "url": "/?go=add"
    }
  ]
}
